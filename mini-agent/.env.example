# Pick a provider. Defaults to "anthropic" if unset.
# Options: anthropic | gemini | groq
PROVIDER=anthropic

# Required when PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional override
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Required when PROVIDER=gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override
# GEMINI_MODEL=gemini-2.5-flash

# Required when PROVIDER=groq — free tier at https://console.groq.com/keys
GROQ_API_KEY=
# Optional override. Any Groq tool-use-capable model works.
# GROQ_MODEL=llama-3.3-70b-versatile
